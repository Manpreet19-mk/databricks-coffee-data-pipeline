{
  "datasets": [
    {
      "name": "af8a3d5d",
      "displayName": "Monthly Coffee Sales and Transaction Summary",
      "queryLines": [
        "SELECT\r\n",
        "  sales_month,\r\n",
        "  total_sales,\r\n",
        "  total_transactions,\r\n",
        "  total_discount,\r\n",
        "  avg_order_value\r\n",
        "FROM coffee.gold.agg_monthly_sales\r\n",
        "ORDER BY sales_month;\r\n"
      ]
    },
    {
      "name": "4a5c9892",
      "displayName": "Monthly Coffee Sales and Transactions Trends",
      "queryLines": [
        "SELECT\r\n",
        "  date_format(sales_month, 'yyyy-MM') AS sales_month,\r\n",
        "  total_transactions\r\n",
        "FROM coffee.gold.agg_monthly_sales\r\n",
        "ORDER BY sales_month;\r\n"
      ]
    },
    {
      "name": "2ffbc385",
      "displayName": "Monthly Sales Averages for Coffee Products",
      "queryLines": [
        "SELECT\r\n",
        "  date_format(sales_month, 'yyyy-MM') AS sales_month,\r\n",
        "  avg_order_value\r\n",
        "FROM coffee.gold.agg_monthly_sales\r\n",
        "ORDER BY sales_month;\r\n"
      ]
    },
    {
      "name": "0adab1d3",
      "displayName": "Coffee Payment Method Sales Insights",
      "queryLines": [
        "SELECT\r\n",
        "  method_name,\r\n",
        "  category,\r\n",
        "  total_transactions,\r\n",
        "  total_sales,\r\n",
        "  avg_order_value\r\n",
        "FROM coffee.gold.agg_payment_method_split\r\n",
        "ORDER BY total_sales DESC;\r\n",
        "\r\n"
      ]
    },
    {
      "name": "f89f2017",
      "displayName": "Top Coffee Store Performance Insights",
      "queryLines": [
        "SELECT\r\n",
        "  store_name,\r\n",
        "  city,\r\n",
        "  state,\r\n",
        "  total_transactions,\r\n",
        "  total_sales,\r\n",
        "  avg_order_value,\r\n",
        "  total_discount\r\n",
        "FROM coffee.gold.agg_store_performance\r\n",
        "ORDER BY total_sales DESC\r\n",
        "LIMIT 5;\r\n"
      ]
    },
    {
      "name": "7bfceb2e",
      "displayName": "Top Coffee Menu Items by Sales Performance",
      "queryLines": [
        "SELECT\r\n",
        "  item_name,\r\n",
        "  category,\r\n",
        "  total_quantity_sold,\r\n",
        "  total_sales\r\n",
        "FROM coffee.gold.agg_top_3_menu_items\r\n",
        "ORDER BY total_sales DESC;\r\n"
      ]
    },
    {
      "name": "3e16f317",
      "displayName": "Coffee Shop Item Sales Summary",
      "queryLines": [
        "SELECT SUM(quantity) AS total_items_sold\r\n",
        "FROM coffee.gold.fact_transaction_items;\r\n"
      ],
      "catalog": "coffee",
      "schema": "gold"
    }
  ],
